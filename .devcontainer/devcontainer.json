{
  "name": "phantom",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": ["--gpus=all", "--shm-size=8g"],
  // Run `git clone --recurse-submodules ...` (or `git submodule update
  // --init --recursive`) on the HOST before opening this folder in the
  // container. The submodule remotes are SSH URLs, and there's no reliable
  // no-config way to forward an ssh-agent into the container here -- if you
  // want that instead of initializing on the host, add a "mounts" entry
  // binding your host's $SSH_AUTH_SOCK to e.g. /ssh-agent and set
  // containerEnv.SSH_AUTH_SOCK to match.
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post_create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
